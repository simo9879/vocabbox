[connection signal="pressed" from="Margin/Scroll/Center/Content/Actions/PrimaryAction" to="." method="_on_action_pressed" binds= ["resume"]]

[connection signal="pressed" from="Margin/Scroll/Center/Content/Actions/Restart" to="." method="_on_action_pressed" binds= ["restart"]]

[connection signal="pressed" from="Margin/Scroll/Center/Content/Actions/Settings" to="." method="_on_action_pressed" binds= ["settings"]]

[connection signal="pressed" from="Margin/Scroll/Center/Content/Actions/QuitToTitle" to="." method="_on_action_pressed" binds= ["title"]]
