[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/settings_menu.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/empty-blackboard.jpg" id="2"]
[ext_resource type="Theme" path="res://scenes/ui/chalk_theme.tres" id="3"]

[node name="SettingsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3")
script = ExtResource("1")

[node name="Blackboard" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.1
anchor_top = 0.1
anchor_right = 0.9
anchor_bottom = 0.9
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("2")
expand_mode = 1

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.1
anchor_top = 0.1
anchor_right = 0.9
anchor_bottom = 0.9
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 64
theme_override_constants/margin_bottom = 40

[node name="Scroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Center" type="CenterContainer" parent="Margin/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Content" type="VBoxContainer" parent="Margin/Scroll/Center"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Heading" type="Label" parent="Margin/Scroll/Center/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "Make yourself comfortable"
horizontal_alignment = 1

[node name="VoiceLabel" type="Label" parent="Margin/Scroll/Center/Content"]
layout_mode = 2
text = "Voice"

[node name="Voice" type="HSlider" parent="Margin/Scroll/Center/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
max_value = 1.0
step = 0.05
value = 1.0
scrollable = false

[node name="MusicLabel" type="Label" parent="Margin/Scroll/Center/Content"]
layout_mode = 2
text = "Music"

[node name="Music" type="HSlider" parent="Margin/Scroll/Center/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
max_value = 1.0
step = 0.05
value = 1.0
scrollable = false

[node name="EffectsLabel" type="Label" parent="Margin/Scroll/Center/Content"]
layout_mode = 2
text = "Effects"

[node name="Effects" type="HSlider" parent="Margin/Scroll/Center/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
max_value = 1.0
step = 0.05
value = 1.0
scrollable = false

[node name="Explanation" type="Label" parent="Margin/Scroll/Center/Content"]
custom_minimum_size = Vector2(600, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Voiced lines have subtitles. Answers are read only when you press Listen.
Choose a written answer, or hold E to speak when the conversation offers it."
horizontal_alignment = 1
autowrap_mode = 3

[node name="PrimaryAction" type="Button" parent="Margin/Scroll/Center/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 52)
layout_mode = 2
size_flags_horizontal = 4
text = "Back"

[connection signal="pressed" from="Margin/Scroll/Center/Content/PrimaryAction" to="." method="_on_action_pressed" binds= ["back"]]

[connection signal="value_changed" from="Margin/Scroll/Center/Content/Voice" to="." method="_on_volume_changed" binds= ["Voice"]]

[connection signal="value_changed" from="Margin/Scroll/Center/Content/Music" to="." method="_on_volume_changed" binds= ["Music"]]

[connection signal="value_changed" from="Margin/Scroll/Center/Content/Effects" to="." method="_on_volume_changed" binds= ["Effects"]]
