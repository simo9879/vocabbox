[gd_resource type="Resource" script_class="" load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/lesson.gd" id="1"]
[resource]
script = ExtResource("1")
encounters = {"worker": {"name": "Alex · Shop helper", "prompt": "Hello! What are you looking for?", "reply": "The bananas are in the produce section. Look for the yellow sign!", "choices": [["unclear", "Where bananas is?", 0, "Try “Where are the bananas?” Put “are” before “the bananas” in this question."], ["clear", "Where are the bananas?", 1, "That is correct English! Add “Excuse me” and “could you” to make your request more polite."], ["strong", "Excuse me, could you tell me where the bananas are?", 2, "A clear and polite question. Lovely work!"]]}, "customer": {"name": "Sam · Fellow shopper", "prompt": "Hello! I like bananas. What fruit do you like?", "reply": "Me too! Bananas make a tasty snack. Have a lovely day!", "choices": [["unclear", "The door is blue.", 0, "Tell Sam about fruit you like. Try “I like bananas.”"], ["clear", "I like bananas.", 1, "That is a correct answer! You can keep the conversation going by asking a question."], ["strong", "I like bananas. Do you like apples too?", 2, "You shared your answer and asked a friendly question!"]]}, "cashier": {"name": "Jo · Checkout", "prompt": "Hello! How can I help you today?", "reply": "Of course! Here are your bananas. Thank you for shopping with us!", "choices": [["unclear", "Bananas me give.", 0, "Try “I would like these bananas, please.” It tells Jo what you want."], ["clear", "I want these bananas.", 1, "Jo understands you. “I would like” and “please” make this request more polite."], ["strong", "I would like these bananas, please.", 2, "A lovely polite request. You are ready to shop in English!"]]}}
lines = {"arrival": "Hello! I am Pip. Let’s buy some bananas! Find the green supermarket door.", "intro": "Welcome to Sunny Market! First, ask the worker where the bananas are. I will help you along the way.", "collected": "One bunch of bananas! Now say hello to the customer by the apples.", "locked": "Let’s finish the next task on our checklist first.", "duplicate": "You already have one bunch. That is all we need!", "done": "You did it! You used English to buy bananas. Keep exploring and practising!", "closed": "This place opens in a future adventure. Let’s visit Sunny Market!"}
objectives = {0: "Find Sunny Market", 1: "Ask the worker", 2: "Collect bananas", 3: "Talk to the customer", 4: "Check out", 5: "Mission complete!"}
hints = {0: "Look for the green Sunny Market entrance.", 1: "Alex is beside the welcome sign. Walk over and press E.", 2: "Follow the yellow PRODUCE sign to the bananas.", 3: "Sam is near the red apples. Say hello!", 4: "Jo is behind the checkout counter.", 5: "Great shopping! Your results are ready."}
voice_paths = {"A clear and polite question. Lovely work!": "res://audio/e19de6ec8c5ea54a03616b2603bda8f681ae900f8e2d9478db2f0cf4a2fb70c9.wav", "A lovely polite request. You are ready to shop in English!": "res://audio/e9fed6945876a81795d461cd29395949d287291100bb342a65c25818301dc974.wav", "Alex is beside the welcome sign. Walk over and press E.": "res://audio/82dceaffe01518cb6735d408a496e2644003c8db4593e0d301fb88606675c1d0.wav", "Bananas me give.": "res://audio/05f5eecd626bbb3262e1187a8294a17b5df672fdb6e22015ff58e549d8a41acc.wav", "Excuse me, could you tell me where the bananas are?": "res://audio/e29d1036b850074153f96f1dc13f6c2088ef959dc0cc513369f352392bd5d402.wav", "Follow the yellow PRODUCE sign to the bananas.": "res://audio/3f6dcbadc8465bb7060a88de726d08a133c1a8473c273db712b4c2498ca816ef.wav", "Great shopping! Your results are ready.": "res://audio/05e9ec467491f388af3dea3532a553392450e5960e80fcd896463110d492269d.wav", "Hello! How can I help you today?": "res://audio/fda564ba3f7a0f028106d468420f674898ed99ac5bf2765ac9586206e39d73c5.wav", "Hello! I am Pip. Let’s buy some bananas! Find the green supermarket door.": "res://audio/fd5298dd278b49c59750d8428a7eafd908a7269be2a8d1e86a069f74ab525ad0.wav", "Hello! I like bananas. What fruit do you like?": "res://audio/19f88f60fc745e20472abe00c92920d22acd3128c05b507208fa1211a35b9c17.wav", "Hello! What are you looking for?": "res://audio/b5c408f68a933f021991b58a7d5f463ca6b1e52630cfd0b3fd20bee584a5d04c.wav", "I like bananas.": "res://audio/fcca176195b2d682c87df83582843392679719b9dbfb130663dcbd6f041ca49a.wav", "I like bananas. Do you like apples too?": "res://audio/c6a57a723ab3e38e93efb1dba3dd8d2e91b538bbcda229bb2111c3693b46012b.wav", "I want these bananas.": "res://audio/ddf761d61d820ef75e409cef538f2d8933d59a3967633a74371a8d22446b291f.wav", "I would like these bananas, please.": "res://audio/4415b86e1a8d536e3960a90a71a867d880ed9293ab796fa3af1310d56784322e.wav", "Jo is behind the checkout counter.": "res://audio/7fac5793ad6ec6cf088eccd46c2e5ed3c05396721feb84441b8fc09b8a056ae1.wav", "Jo understands you. “I would like” and “please” make this request more polite.": "res://audio/6eb4b8cdcbd9cd86271c4a99a64dc418839e1a5bddf2dd7c0c7a60a692f72134.wav", "Let’s finish the next task on our checklist first.": "res://audio/9a4d9d8ce2bba20324e6f647628a7ad0279c5b324252998c9bfef2693aa61d7f.wav", "Look for the green Sunny Market entrance.": "res://audio/1acc96ee233e4c2b8125e5563d224a7f15ae76b917a210cf02dc1df0f134ff13.wav", "Me too! Bananas make a tasty snack. Have a lovely day!": "res://audio/aee56ea1df89ca1a3f5538fa2c4b45f046d1e40494125fdad2472b1858ff64b8.wav", "Of course! Here are your bananas. Thank you for shopping with us!": "res://audio/e64e7c8271405e9d05925bfe2216b031344f94a2324e2e92cce81452195e0b77.wav", "One bunch of bananas! Now say hello to the customer by the apples.": "res://audio/8e4c643db52b459fe8eedf0d0588ae2f59249a14d42007b09c1a153bf16261c6.wav", "Sam is near the red apples. Say hello!": "res://audio/2087365b5a0849837afeb6b280fbc01287038fe9428d95699b5baaceef86f203.wav", "Tell Sam about fruit you like. Try “I like bananas.”": "res://audio/ce5e5557bb971642d3097a778934de70e26ee3e4bd3c073387bb9cdd700b407f.wav", "That is a correct answer! You can keep the conversation going by asking a question.": "res://audio/b9dce708203c8829b68d3d916044ee9e470c872765edf6cc323b8148e125a425.wav", "That is correct English! Add “Excuse me” and “could you” to make your request more polite.": "res://audio/a3d85a755cee4721f19a63e775883a49473eecd2d9982e78c97f5a05108515fa.wav", "The bananas are in the produce section. Look for the yellow sign!": "res://audio/e4bb8c8543a666ca1475ebf5c13b3aed3cac00a6a99b12f4db15ae48a8cc97d0.wav", "The door is blue.": "res://audio/9231126dd6726e86796e975155e8183f1662d95f2fe3051e9ecce1984f57b70f.wav", "This place opens in a future adventure. Let’s visit Sunny Market!": "res://audio/d78755d6cbf15d0467cedba99c6774dc7219b938fcf0b48d876f2890193aba50.wav", "Try “I would like these bananas, please.” It tells Jo what you want.": "res://audio/fcdbf1add68bca343e3210c7ea86bf65e595456f39f5d5c756af64d0f2b862e5.wav", "Try “Where are the bananas?” Put “are” before “the bananas” in this question.": "res://audio/e2c019a52f6cdd7fad32d903bc3a2519b4fe0e07b075f21fe8c08bfc50a72aa4.wav", "Welcome to Sunny Market! First, ask the worker where the bananas are. I will help you along the way.": "res://audio/3f86666bd085fb515e318d1135c69008b35cb2875f84c82eb44c25f261fe071a.wav", "Where are the bananas?": "res://audio/c57d8e2b108196efea0ca98c181d0e7f46d0f5b10e7f141f66ee40d5cb55e3b1.wav", "Where bananas is?": "res://audio/e608e6018051ea50de3ee88ef2892213989aa4129239e9838334bafcbff60df8.wav", "You already have one bunch. That is all we need!": "res://audio/8284d23a5dcfbe239349bc93d38f7552674d6d8c536d9a3d8b04979851b718ee.wav", "You did it! You used English to buy bananas. Keep exploring and practising!": "res://audio/6058b83eb46aa3c056e9a4c0e31465cb7de46f35d7f3a78b220eb9efb8d657a9.wav", "You shared your answer and asked a friendly question!": "res://audio/913d396cfcb336e8d454982322e6171c46c12844b3e64db704a8dc8df85d8f44.wav"}
